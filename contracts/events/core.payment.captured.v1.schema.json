{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wasla/events/core.payment.captured.v1.schema.json",
  "title": "core.payment.captured v1",
  "description": "Published when CORE captures an existing payment authorization into the ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": ["authorization_id", "wallet_id", "transaction_id", "amount_minor", "currency", "business_reference"],
  "properties": {
    "authorization_id": { "type": "string", "format": "uuid" },
    "wallet_id": { "type": "string", "format": "uuid" },
    "transaction_id": { "type": "string", "format": "uuid" },
    "amount_minor": { "type": "integer", "minimum": 1 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "business_reference": { "type": "string", "minLength": 1 }
  },
  "examples": [{ "authorization_id": "6cf05081-f2c6-451a-a898-16043100db4f", "wallet_id": "48fac898-50c5-4228-a932-14e9d2f7ec15", "transaction_id": "1f05fd37-9944-4469-a2ea-2596fc2fd12e", "amount_minor": 1250, "currency": "SAR", "business_reference": "order-44" }]
}