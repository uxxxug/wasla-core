{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wasla/events/move.job.accepted.v1.schema.json",
  "title": "move.job.accepted v1",
  "description": "Consumed by CORE when MOVE has created an operational job for an opaque fulfillment reference. CORE never learns the job's contents.",
  "type": "object",
  "additionalProperties": false,
  "required": ["fulfillment_id", "job_id", "accepted_at"],
  "properties": {
    "fulfillment_id": { "type": "string", "format": "uuid" },
    "job_id": { "type": "string", "minLength": 1 },
    "accepted_at": { "type": "string", "format": "date-time" }
  },
  "examples": [
    {
      "fulfillment_id": "e53bd31b-06e4-4609-a109-fcfe6848376d",
      "job_id": "job-9",
      "accepted_at": "2026-09-11T03:40:00.000Z"
    }
  ]
}
