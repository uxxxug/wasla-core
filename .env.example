# WASLA CORE — environment template.
# Copy to .env locally. Never commit a filled-in copy; .env is git-ignored.

# HTTP
PORT=8080

# Outbox relay poll interval (milliseconds)
OUTBOX_RELAY_INTERVAL_MS=1000

# CORE database (not yet provisioned — see ROADMAP.md blocker B-1)
# DATABASE_URL=postgres://user:password@host:5432/wasla_core

# Service-to-service trust (issued per calling system, supplied by the platform)
# MOVE_SERVICE_AUDIENCE=wasla-move
# MARKET_SERVICE_AUDIENCE=wasla-market
